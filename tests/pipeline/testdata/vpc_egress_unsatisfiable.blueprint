version "2025-11-02"

transform "celerity-2026-02-27-draft"

# An isolated network routes nothing outwards, and this handler asks for the
# internet anyway. The author asked for something the topology cannot deliver, so
# the transform must say so rather than deploy a rule that grants nothing.
resource reachingHandler: celerity/handler {
    metadata {
        labels = { network = "isolated" }
        annotations = {
            "celerity.handler.vpc.egress" = "internet"
        }
    }
    spec {
        handlerName = "reachingHandler"
        handler = "handlers.reach"
        runtime = "nodejs24.x"
    }
}

resource isolatedNetwork: celerity/vpc {
    select by label {
        network = "isolated"
    }
    spec {
        name = "isolated-net"
        preset = "isolated"
    }
}
